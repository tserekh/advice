```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
env/

# Dependencies
node_modules/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Build artifacts
dist/
build/
target/

# Temporary files
*.tmp
*.swp

# Coverage reports
.coverage
coverage/
htmlcov/

# Python cache
.mypy_cache/
.pytest_cache/

# OS generated files
.DS_Store
Thumbs.db
```